{
  "manifest_version": 3,
  "name": "Scripra — Bot-Free Google Meet Intelligence",
  "version": "1.0.0",
  "description": "100% Bot-Free real-time conversation intelligence, live MoM, and decision extraction for Google Meet.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:3000/*",
    "https://*.scripra.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scripra Conversation Intelligence",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
