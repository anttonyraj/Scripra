# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/bot-worker/node_modules/
**/.test-bot-profile/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.vscode/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*
!.env.example

# bot browser profiles & user session directories (prevent credential leaks)
.bot-profile/
.webex-edge-profile/
.guest-profiles/
*.bot-profile/
google-session.json
*.session.json
transcripts/
diagnostics/
SelfHosted-GuestBot/
SelfHosted-GuestBot.zip
SingletonLock
SingletonCookie
SingletonSocket

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
